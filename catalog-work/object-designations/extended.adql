SELECT ident.id AS query_id,basic.main_id,ids.ids FROM ident JOIN basic ON ident.oidref=basic.oid JOIN ids ON basic.oid=ids.oidref WHERE ident.id IN ('Abell 35','Ced 129','Gaia DR3 4318465066420528000','Gaia DR3 4373465352415301632','Gaia DR3 6328149636482597888','IC 4592','IC 4601','IC 4603','IC 4604','IC 4605','IC 4606','LBN 1099','LBN 1107','LBN 1109','LBN 1110','LBN 1111','LBN 1113','LBN 24','LBN 744','M 42','NGC 1555','NGC 1976','PN G158.6+00.7','PN G303.6+40.0','Sh 2-216','Sh 2-27','Sh 2-281','Sh 2-313','Sh 2-7','vdB 100','vdB 101','vdB 102','vdB 103','vdB 105','vdB 106','vdB 107','vdB 108','vdB 109','vdB 111','vdB 129','vdB 156','vdB 25','vdB 26','vdB 27','vdB 28','vdB 7') ORDER BY query_id
