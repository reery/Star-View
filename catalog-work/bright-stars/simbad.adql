SELECT DISTINCT
  b.main_id,
  b.ra,
  b.dec,
  b.otype,
  b.sp_type,
  b.plx_value,
  b.plx_err,
  b.pmra,
  b.pmdec,
  b.rvz_radvel,
  f.flux AS V
FROM basic AS b
JOIN flux AS f ON b.oid = f.oidref
JOIN otypes AS o ON b.oid = o.oidref
WHERE f.filter = 'V'
  AND f.flux < 2.70
  AND b.plx_value >= 1.0871879257
  AND o.otype = '*'
ORDER BY V
