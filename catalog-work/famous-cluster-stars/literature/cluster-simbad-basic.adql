SELECT i.id AS query_id,b.*,ids.ids FROM ident i JOIN basic b ON b.oid=i.oidref LEFT JOIN ids ON ids.oidref=b.oid WHERE i.id IN ('*   7 Com','*  12 Com','*  14 Com','*  16 Tau','*  17 Tau','*  20 Tau','*  21 Tau','*  23 Com','*  23 Tau','*  27 Tau','*  28 Tau','*  31 Com','*  35 Cnc','*  39 Cnc','* c Tau','* del Tau','* eps Cnc','* eps Tau','* eta Tau','* gam Tau','* kap01 Tau','* omi Vel','* q Tau','* tet Car','* tet01 Ori A','* tet01 Ori B','* tet01 Ori C','* tet01 Ori D','* tet01 Tau','* tet02 Tau','* ups Tau','2MASS J12350326+2237254','HD  73598','HD  73710','HD  74146','HD  74196','HD  74560','HD  92938','HD  93194','HD  93549','HD  93607','V* HW Vel','V* KT Vel')
