SELECT i.id AS query_id, b.main_id, b.ra, b.dec, b.otype, b.sp_type, b.plx_value, b.plx_err, b.pmra, b.pmdec, b.rvz_radvel, f.flux AS V, a.ids FROM ident AS i JOIN basic AS b ON i.oidref=b.oid JOIN ids AS a ON b.oid=a.oidref LEFT OUTER JOIN flux AS f ON b.oid=f.oidref AND f.filter='V' WHERE i.id IN ('HIP 17489','HIP 17499','HIP 17531','HIP 17579','HIP 17573','HIP 17608','HIP 17702','HIP 17847','HIP 17851','* tet01 Ori A','* tet01 Ori B','* tet01 Ori C','* tet01 Ori D','HIP 20894','HIP 20889','HIP 20205','HIP 20455','HIP 20885','HIP 20635','HIP 21589','HIP 20711','HIP 61394','HIP 60351','HIP 59847','HIP 62763','HIP 60697','HIP 52419','HIP 52502','HIP 52370','HIP 52736','HIP 52701','HIP 42536','HIP 42726','HIP 42504','HIP 42459','HIP 42715','HIP 42535','HIP 42556','HIP 42549','HIP 42516','HIP 42133','HIP 42497')
