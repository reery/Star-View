SELECT b.main_id, b.ra, b.dec, b.coo_bibcode, b.otype, b.sp_type, b.sp_bibcode, b.plx_value, b.plx_err, b.plx_bibcode, b.pmra, b.pmdec, b.pm_err_maj, b.pm_err_min, b.pm_err_angle, b.pm_bibcode, b.rvz_radvel, b.rvz_err, b.rvz_bibcode, f.flux AS V, f.flux_err AS V_err, f.bibcode AS V_bibcode, i.ids FROM basic AS b JOIN flux AS f ON b.oid=f.oidref AND f.filter='V' LEFT OUTER JOIN ids AS i ON b.oid=i.oidref WHERE f.flux <= 6.5 ORDER BY main_id
