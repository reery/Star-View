SELECT c.main_id AS child_id, p.main_id AS parent_id, p.otype, p.plx_value, p.plx_err, p.plx_bibcode, h.membership, h.link_bibcode FROM basic AS c JOIN flux AS f ON c.oid=f.oidref AND f.filter='V' JOIN h_link AS h ON h.child=c.oid JOIN basic AS p ON p.oid=h.parent WHERE f.flux <= 6.5 AND p.otype IN ('OpC', 'Cl*', 'GlC') AND p.plx_value IS NOT NULL ORDER BY child_id, parent_id, link_bibcode
