{
  "schemaVersion": 1,
  "reviewedOn": "2026-10-16",
  "policy": "Exact GJ 860 A/B identities. Adopt individual dynamical masses, Gaia-resolved photometric temperature/luminosity estimates and calibrated radii. Deblend Johnson V with the published system V and delta V. Preserve all previous effective records and source uncertainties. No binary-total flux, abundance, age or systemic velocity is assigned to an individual.",
  "pipelineCause": [
    "Nearest-100 withheld Johnson V for every new multi-star system pending resolved passband evidence; both components retained only generic M3/M4 dwarf temperatures.",
    "The shared companion pool alone filled B mass/radius/abundance from Cifuentes 2025; A was excluded by the generic Category=3 filter. Category=3 describes the available data in that survey, not whether this established visual binary exists.",
    "The nearest-1000 component-property subset did not include either Kruger 60 star. A dedicated review was missing."
  ],
  "sources": [
    {
      "name": "Benedict et al. 2016, Table 11, GJ 860 A/B dynamical masses; original references Tamazian et al. 2006 / Henry et al. 1999",
      "url": "https://www.astro.gsu.edu/RECONS/published37.pdf"
    },
    {
      "name": "Cifuentes et al. 2025, Table A.1 rows 2457/2458; section 4.2 Gaia absolute-G radius calibration",
      "url": "https://arxiv.org/html/2412.12264v1#S4.SS2"
    },
    {
      "name": "Hardegree-Ullman et al. 2023, Table 1 exact Gaia rows 2007876324466455040 / 2007876324472098432; sections 2.4-2.5",
      "url": "https://arxiv.org/html/2304.12490v1"
    },
    {
      "name": "Henry et al. 1999, Table 3 and footnote h; section 3.1 resolved spectra",
      "url": "https://www.as.utexas.edu/~fritz/astrometry/Papers_in_pdf/%7BHen99%7DMLR.pdf"
    }
  ],
  "inputSha256": {
    "catalog-work/shared-enrichment/kruger-60-bioverse.tsv": "da55282c822e545fb9f57c4dab79dcb27fda7fdfa6f1bfa8d36d58f149cc8c6c"
  },
  "photometryInputs": {
    "systemJohnsonV": 9.57,
    "systemJohnsonVUncertainty": 0.03,
    "deltaV_BminusA": 1.61,
    "deltaVUncertainty": 0.06,
    "reference": "1999ApJ...512..864H:Table 3, Gl 860 B, footnote h",
    "method": "V_A = V_AB + 2.5 log10(1 + 10^(-0.4 deltaV)); V_B = V_A + deltaV. First-order errors assume independent V_AB and deltaV; the derived A/B magnitudes are correlated. Individual absolute V uses each retained catalog distance.",
    "epoch": null,
    "caveat": "Published compiled/deblended baseline photometry; no observing date or flare light curve is supplied. Hipparcos delta magnitude is adopted as delta V by Henry et al., not reclassified here as a direct resolved Johnson exposure."
  },
  "withheld": {
    "age_gyr": "No sufficiently supported scalar component/system age adopted.",
    "A_metallicity": "Newton 2014 comparison row LSPM J2227+5741a explicitly names Gl 860 AB. The -0.04 +/- 0.12 dex result is not adopted as an independent A abundance or copied to B.",
    "Bioverse_Vmag": "Its A row lists V=11.410 +/- 0.050, inconsistent with the established brighter A component; retain this frozen source entry without adopting it. Its temperature uses Gaia BP-RP and luminosity uses Gaia G plus a bolometric correction, not that V value.",
    "Bioverse_binary_flags": "All binary flags are false for these known binary components. Do not use those flags as membership evidence. Gaia resolves both source IDs; photometric T/L remain empirical estimates with possible close-companion contamination/systematic errors, not direct SED/interferometric measurements.",
    "radial_velocity": "Retain the existing separate 1953 component RVs, raw astrometry, errors and motion vectors; no newer systemic solution reviewed here."
  },
