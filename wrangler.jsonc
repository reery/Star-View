{
  "name": "star-view",
  "compatibility_date": "2026-10-21",
  // Renders /objects/<id> from index.html with the object's title, description and summary.
  "main": "worker/index.ts",
  // Production serves only the custom domain; branch builds keep their workers.dev Preview URLs.
  "routes": [{ "pattern": "starview-app.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Object pages invoke the Worker first; other paths reach it only when no asset matches.
    "run_worker_first": ["/objects/*"],
    // Missing chunks must return 404 instead of index.html under an asset URL.
    "not_found_handling": "none"
  },
    "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
}
