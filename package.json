{
  "name": "star-view",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "npm run catalog:generate && vite",
    "dev:manual": "npm run catalog:generate && vite --mode manual",
    "pretypecheck": "npm run catalog:generate",
    "typecheck": "tsc --noEmit",
    "pretypecheck:watch": "npm run catalog:generate",
    "typecheck:watch": "tsc --noEmit --watch",
    "pretest": "npm run catalog:generate",
    "test": "vitest run src",
    "test:e2e": "npm run build && playwright test",
    "build": "npm run catalog:validate && npm run catalog:generate && tsc && vite build",
    "catalog:preservation": "python3 scripts/audit-catalog-preservation.py",
    "catalog:validate": "npm run catalog:preservation && python3 scripts/author-stellar-companions.py --check && python3 scripts/author-constellations.py && python3 scripts/author-top-lists.py --check && node scripts/catalogs.ts validate",
    "catalog:generate": "python3 scripts/author-stellar-companions.py --check && node scripts/catalogs.ts generate",
    "catalog:companions": "python3 scripts/author-stellar-companions.py --write",
    "catalog:build": "node scripts/catalogs.ts build",
    "preview": "vite preview",
    "catalog:white-dwarf-references": "python3 scripts/extract-white-dwarf-references.py && node scripts/catalogs.ts white-dwarf-references"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/papaparse": "^5.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "papaparse": "^5.7.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "lucide": "^1.46.0",
    "three": "^0.186.0"
  }
}
