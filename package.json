{
  "name": "star-view",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run catalog:generate && vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "npm run build && playwright test",
    "build": "npm run catalog:validate && npm run catalog:generate && tsc && vite build",
    "catalog:validate": "node scripts/catalogs.ts validate",
    "catalog:generate": "node scripts/catalogs.ts generate",
    "catalog:build": "node scripts/catalogs.ts build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/papaparse": "^5.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "papaparse": "^5.7.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lucide": "^1.46.0",
    "three": "^0.186.0"
  }
}
